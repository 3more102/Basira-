# Local coding model served by Ollama. Change to another installed Ollama model if desired.
BASIRA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://127.0.0.1:11434
BASIRA_NUM_CTX=16384

# Optional path to the repository Basira may inspect. Defaults to this project folder.
# BASIRA_WORKSPACE=C:\path\to\repository

# Local server settings. Basira only accepts loopback host values.
BASIRA_HOST=127.0.0.1
BASIRA_PORT=8000
